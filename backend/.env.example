# ==============================================================================
# FlowForage Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DATABASE & QUEUE
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/flowforage?sslmode=disable"
REDIS_URL=redis://localhost:6379
PORT=3000

# ------------------------------------------------------------------------------
# 2. SECURITY & ENCRYPTION
# ------------------------------------------------------------------------------
# 32-character key for AES-256-GCM encryption of stored access tokens & credentials
ENCRYPTION_KEY=flowforage-aes-secret-key-32-chars-long!

# Server base URL (where this NestJS backend runs)
APP_BASE_URL=http://localhost:3000

# Frontend URL (for OAuth redirect callbacks after login or connecting apps)
FRONTEND_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 3. USER AUTHENTICATION (GOOGLE SIGN-IN)
# Obtain from: https://console.cloud.google.com/apis/credentials
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ------------------------------------------------------------------------------
# 4. APP INTEGRATIONS OAUTH CREDENTIALS (FOR CONNECTING USER ACCOUNTS)
# ------------------------------------------------------------------------------

# GitHub OAuth App: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Slack App: https://api.slack.com/apps
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Linear OAuth Client: https://linear.app/settings/api/applications/new
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Notion Integration: https://www.notion.so/my-integrations
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Todoist App Console: https://developer.todoist.com/appconsole.html
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=

# Discord Developer Portal: https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 5. INCOMING WEBHOOK SECRETS (FOR EVENT SIGNATURE VERIFICATION)
# ------------------------------------------------------------------------------
# GitHub webhook secret configured in repository webhook settings
GITHUB_WEBHOOK_SECRET=

# Slack Signing Secret from Basic Information in Slack App Dashboard
SLACK_SIGNING_SECRET=

# Linear webhook signing secret from Linear team webhook settings
LINEAR_WEBHOOK_SECRET=
